      }
    },
    "No private Space APIs available; a public minimize → deminimize sequence may pull windows onto this Space." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine privaten Bereichs-APIs verfügbar; eine öffentliche Minimieren→Wiederherstellen-Sequenz kann Fenster auf diesen Bereich ziehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No private Space APIs available; a public minimize → deminimize sequence may pull windows onto this Space."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune API privée d’espace disponible ; une séquence publique réduire → réafficher peut ramener les fenêtres sur cet espace."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuna API privata degli spazi disponibile; una sequenza pubblica riduci → ripristina può portare le finestre in questo spazio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "利用可能な private Space API はありません。公開の最小化→復元シーケンスでこの Space にウィンドウが移動する場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용 가능한 private Space API가 없습니다. 공개 최소화→복원 시퀀스로 이 Space로 창이 이동될 수 있습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нет доступных приватных API Space; публичная последовательность свернуть → восстановить может переместить окна в этот Space."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有可用的私有 Space API；可能会用公开的最小化→还原流程把窗口拉到当前空间。"
          }
        },
        "zh-Hant" : {
