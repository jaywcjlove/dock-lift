    "Click a Dock icon and DockLift brings that app’s most recently used window to the current Space, then activates it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicken Sie auf ein Dock-Symbol, und DockLift bringt das zuletzt verwendete Fenster dieser App in den aktuellen Bereich und aktiviert es."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Click a Dock icon and DockLift brings that app’s most recently used window to the current Space, then activates it."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cliquez sur une icône du Dock et DockLift amène la fenêtre la plus récemment utilisée de cette app sur l’espace actuel, puis l’active."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai clic su un’icona del Dock e DockLift porta la finestra usata più di recente di quell’app nello spazio corrente, quindi la attiva."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dock アイコンをクリックすると、DockLift はその App の最近使ったウィンドウを現在の Space に移動し、アクティブにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dock 아이콘을 클릭하면 DockLift가 해당 앱의 가장 최근에 사용한 창을 현재 Space로 가져온 다음 활성화합니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите значок Dock, и DockLift перенесёт последнее использованное окно этого приложения в текущий Space, а затем активирует его."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点击 Dock 图标时，DockLift 会将该应用最近使用的窗口带到当前空间并激活。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點按 Dock 圖示時，DockLift 會將該 App 最近使用的視窗帶到目前空間並啟用。"
          }
        }
      }
    },
